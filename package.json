{
  "name": "shadcn-preact",
  "version": "0.1.0",
  "private": true,
  "author": {
    "name": "LiasCode",
    "email": "liascode.dev@gmail.com",
    "url": "https://lias-code.pages.dev"
  },
  "bin": {
    "shadcn-preact": "cli/index.ts"
  },
  "files": [
    "cli/",
    "registry/ui/",
    "src/styles/shadcn-tailwind.css",
    "LICENSE.md"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "lint": "oxlint",
    "upstream:setup": "git submodule update --init --recursive",
    "check": "bunx oxfmt --check && bun run registry:check && bun run test && bun run parity:test && bun run parity && bun run lint && bun run build",
    "reference": "bun scripts/reference.ts",
    "parity": "bun scripts/parity.ts",
    "parity:test": "bun scripts/parity-regressions.ts",
    "test": "bun test",
    "performance": "bun scripts/performance.mjs",
    "parity:browser": "bun scripts/browser-parity/prepare.ts && node scripts/browser-parity/compare.mjs",
    "parity:browser:test": "bun scripts/browser-parity/prepare.ts && node scripts/browser-parity/mutations.mjs",
    "cli": "bun cli/index.ts",
    "registry:build": "bun scripts/component-registry.ts && bunx oxfmt cli/registry.json",
    "registry:check": "bun scripts/component-registry.ts --check",
    "clean": "rm -rf .cache node_modules bun.lock package-lock.json dist"
  },
  "dependencies": {
    "@floating-ui/react-dom": "2.1.9",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "date-fns": "4.4.0",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lucide-preact": "1.51.0",
    "preact": "11.0.0",
    "preact-iso": "2.12.2",
    "react-day-picker": "10.0.2",
    "react-resizable-panels": "4.14.2",
    "recharts": "3.10.1",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@base-ui/react": "1.6.0",
    "@happy-dom/global-registrator": "20.14.5",
    "@preact/preset-vite": "2.10.6",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.4",
    "happy-dom": "20.14.5",
    "lucide-react": "0.474.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "pixelmatch": "7.1.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "preact-render-to-string": "6.8.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwindcss": "4.3.3",
    "ts-morph": "28.0.0",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "zod": "4.6.5"
  }
}
